<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CustomTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeColor">@android:color/transparent</item>
    </style>
    
    <style name="TextAppearance.AppCompat.TextViewVariantStyle">
        <item name="android:textColor">@color/white</item>

    </style>

    <style name="TextAppearance.AppCompat.TextViewVariantStyle.Header">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="TextAppearance.AppCompat.TextViewVariantStyle.Title">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.AppCompat.TextViewVariantStyle.TextInputHint">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColorHint">@color/gray_hint</item>
    </style>

    <style name="TextAppearance.AppCompat.TextViewVariantStyle.ButtonText">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.AppCompat.TextViewVariantStyle.HintText">
        <item name="android:fontFamily">@font/roboto_semi_bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.AppCompat.TextViewVariantStyle.HintText.Navigate">
        <item name="android:textColor">@color/green</item>
    </style>
</resources>
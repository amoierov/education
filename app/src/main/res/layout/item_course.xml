<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gray_color"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="114dp">

            <ImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="image_course"
                android:scaleType="centerCrop"
                android:src="@color/white" />

            <!-- Блок с рейтингом -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_blur_shape"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp"
                    android:paddingStart="7dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="image_star"
                        android:scaleType="centerInside"
                        android:src="@drawable/star_fill" />

                    <TextView
                        android:textColor="@color/white"
                        android:id="@+id/rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4.9" />
                </LinearLayout>

                <TextView
                    android:textColor="@color/white"
                    android:id="@+id/date"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_blur_shape"
                    android:paddingVertical="5dp"
                    android:paddingStart="7dp"
                    android:paddingEnd="6dp"
                    android:text="22 мая 20022" />

            </LinearLayout>

            <ImageView
                android:id="@+id/save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_blur_shape"
                android:padding="6dp"
                android:src="@drawable/bookmark" />
        </FrameLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/TextAppearance.AppCompat.TextViewVariantStyle.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Java-разработчик" />

            <TextView
                android:id="@+id/description"
                style="@style/TextAppearance.AppCompat.TextViewVariantStyle.TextInputHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#B3F2F2F3"
                tools:text="Освойте backend-разработку dwadwaивцфвцфвцфвцфвцф программирование на Java, фреймворкиdwad" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/price"
                    style="@style/TextAppearance.AppCompat.TextViewVariantStyle.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="999 ₽" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.AppCompat.TextViewVariantStyle.Title"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginBottom="1.5dp"
                        android:text="Подробнее"
                        android:textColor="@color/green" />

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="image_arrow_right"
                        android:scaleType="centerCrop"
                        android:src="@drawable/arrow_right_short_fill" />
                </LinearLayout>

            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

